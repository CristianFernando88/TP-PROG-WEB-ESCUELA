# web-app-escuela/.htaccess — Front Controller (TP10)

RewriteEngine On

# 1) Redirigir archivos legacy de autenticación hacia el Front Controller
RewriteRule ^(login|registro|logout)\.php$ index.php [L]

# 2) Archivos y directorios reales (assets/, api/, admin/) se sirven tal cual
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3) Todo lo demás → Front Controller (MVC)
RewriteRule ^ index.php [L]
